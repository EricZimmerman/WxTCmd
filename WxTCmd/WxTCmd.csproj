<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- a single file publish includes the native SQLite library (Microsoft.Data.Sqlite) -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <AssemblyTitle>WxTCmd</AssemblyTitle>
    <Company>Eric Zimmerman</Company>
    <Product>WxTCmd</Product>
    <Description>Windows 10/11 Timeline (ActivitiesCache.db) parser</Description>
    <Copyright>Eric Zimmerman</Copyright>
    <Version>2026.10.0</Version>
    <LangVersion>10</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationIcon>Calendar Money64.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WxTCmd.Test" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Calendar Money64.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="GuidMapping" Version="2026.10.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="System.CommandLine" Version="2.0.13" />
  </ItemGroup>
</Project>
